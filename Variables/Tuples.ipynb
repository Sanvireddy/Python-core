    "# Creating a tuple\n",
    "t = 'hey', 'hi', 9\n",
    "print(t)\n",
    "\n",
    "# Singleton tuple\n",
    "# The trailing comma is necessary to make this a tuple.\n",
    "s = 'hey',\n",
    "print(s)\n",
    "\n",
    "# A tuple containing mutable lists\n",
    "tuple_of_lists = ([1, 2, 3, 4], [5, 6, 7, 8])\n",
    "\n",
    "# The tuple itself is immutable, but the lists inside it are mutable.\n",
    "tuple_of_lists[0][0] = 0\n",
    "print(tuple_of_lists)\n",
    "\n",
    "# This WILL raise a TypeError because we are trying to replace\n",
