    "    updated_todo = put_response.json()\n",
    "    print(f\"Updated Todo ID: {updated_todo['id']}\")\n",
    "    print(f\"Title: {updated_todo['title']}\")\n",
    "    print(f\"Completed: {updated_todo['completed']}\")\n",
