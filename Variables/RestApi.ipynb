    "todo = requests.get('https://jsonplaceholder.typicode.com/todos/1').json()\n",
    "print(todo)\n",
    "todo['completed'] = True\n",
    "# print(api_url+'/'+str(created_todo['id']))\n",
    "put_response = requests.put(api_url+'/'+str(todo['id']), json=todo)\n",
